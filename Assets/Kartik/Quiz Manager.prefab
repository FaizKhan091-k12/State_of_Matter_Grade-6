  topicText: {fileID: 0}
  questionText: {fileID: 0}
  optionsParent: {fileID: 0}
  optionButtonPrefab: {fileID: 4475254973432850009, guid: 9405aaf16d4f66a48babc40f7fc58e75, type: 3}
  feedbackText: {fileID: 0}
  nextButton: {fileID: 0}
  greenTestTubeSprite: {fileID: 21300000, guid: 6c365090bbf7fd945b7c637e0841a0ca, type: 3}
  redTestTubeSprite: {fileID: 21300000, guid: ae86fc2937a1650429b743ff4209d9fd, type: 3}
  questions:
  - topic: "Question 1 \u2013 Solids"
    prompt: How are particles arranged in a solid?
    options:
    - (A) Spread far apart and moving freely
    - (B) Packed tightly, only vibrating
    - (C) Sliding past each other
    correctIndex: 1
    correctFeedback: "Correct \u2192 \"Yes! That\u2019s why solids have a fixed shape.\""
    wrongFeedback: "Wrong \u2192 \"Look again\u2014solids are tightly packed and
      only vibrate.\""
  - topic: "Question 2 \u2013 Liquids"
    prompt: Do liquids have a fixed shape?
    options:
    - (A) Yes
    - (B) No
    correctIndex: 1
    correctFeedback: "Correct \u2192 \"Right! Liquids take the shape of their container.\""
    wrongFeedback: "Wrong \u2192 \"Not quite\u2014liquids change shape but keep their
      volume.\""
  - topic: "Question 3 \u2013 Gases"
    prompt: What happens to gas particles when you heat them?
    options:
    - (A) They slow down and pack together
    - (B) They speed up and spread out
    - (C) They stop moving completely
    correctIndex: 1
    correctFeedback: "Correct \u2192 \"Great! Heat makes particles move faster and
      spread out.\""
    wrongFeedback: "Wrong \u2192 \"Remember, heat gives particles more energy to
      move.\""
  - topic: "Question 4 \u2013 State Changes"
    prompt: Which process changes a liquid into a gas?
    options:
    - (A) Freezing
    - (B) Boiling
    - (C) Condensation
    correctIndex: 1
    correctFeedback: "Correct \u2192 \"Exactly! Boiling (or evaporation) turns liquid
      into gas.\""
    wrongFeedback: "Wrong \u2192 \"Check again\u2014boiling changes liquids into
      gases.\""
  - topic: "Question 5 \u2013 Big Idea"
    prompt: What causes matter to change from one state to another?
    options:
    - (A) Adding or removing heat (temperature change)
    - (B) Changing the container
    - (C) Shaking the particles
    correctIndex: 0
    correctFeedback: "Correct \u2192 \"Yes! Heat changes particle speed, which changes
      state.\""
    wrongFeedback: "Wrong \u2192 \"Not quite\u2014it\u2019s temperature that makes
      particles move differently.\""
